# /opt/egormath/.env — настройки стека (не в git, права 600).
# Секреты самого Django (SECRET_KEY, ключи API, ALLOWED_HOSTS) лежат, как и
# на Timeweb, файлами в data/secrets/ — см. deploy/VPS.md.

# MySQL egormath (контейнер egormath-db). Пароль пользователя попадает в
# Django переменной DB_PASSWORD — в data/secrets/DB_PASSWORD он не нужен.
MYSQL_DATABASE=egormath
MYSQL_USER=egormath
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Имена сайта для общего Caddy (через запятую и пробел, как в Caddyfile).
# Репетиция: vps.math.emukhin.ru; после переключения DNS:
# math.emukhin.ru, vps.math.emukhin.ru
EGORMATH_HOSTS=vps.math.emukhin.ru

# Каталог данных (media, secrets, live, staticfiles, mysql, backups)
DATA_DIR=/opt/egormath/data

GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Бэкапы: хранить дней; копия в S3 Timeweb через rclone (пусто — только диск)
RETENTION_DAYS=14
BACKUP_RCLONE_REMOTE=
