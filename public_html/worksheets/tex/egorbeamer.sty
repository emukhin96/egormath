\fi

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{frametitle continuation}[from second][(продолжение)]
\setbeamersize{text margin left=1.1em,text margin right=1.1em}
\setbeamertemplate{blocks}[rounded][shadow=false]
\usebeamercolor[fg]{normal text}

% --- Пометки egor.sty в тексте задач ---------------------------------
% Тексты задач пишутся под egor.sty и могут содержать его пометки на
% полях: \annot{2011}, \oge, \fipi, \rev, \complex, \home, \source{…}.
% В презентации полей нет, а без определений сборка падала на
% «Undefined control sequence». Выводим их мелкой плашкой в строке;
% \providecommand — чтобы не спорить с egor.sty, если его подключат.
\newcommand{\egorbmr@mark}[1]{%
  \mbox{\footnotesize\color{egor@muted}#1}\enspace\ignorespaces}
\providecommand{\annot}[1]{%
  \egorbmr@mark{\fboxsep=1.5pt\fcolorbox{egor@border}{white}{#1}}}
\providecommand{\annotnoframe}[1]{\egorbmr@mark{#1}}
\providecommand{\oge}{\annot{ОГЭ}}
\providecommand{\fipi}{\annot{ФИПИ}}
\providecommand{\rev}{\annotnoframe{\ensuremath{\circlearrowright}}}
\providecommand{\complex}{\annotnoframe{\ensuremath{\star}}}
\providecommand{\starred}{\annotnoframe{\ensuremath{\star}}}
\providecommand{\home}{\annotnoframe{д/з}}
\providecommand{\source}[1]{{\footnotesize\color{egor@muted}(#1)}}
\providecommand{\textbit}[1]{\textbf{\textit{#1}}}

% --- Макросы содержимого ------------------------------------------
% Звёзды сложности; при nostars команда пустая.
% (Сетка переопределяет на \bigstar.)
\NewDocumentCommand{\egorstars}{m}{%
  \ifegorbmr@stars
    \ifnum#1>0\relax
      \textcolor{egor@star}{%
        \ensuremath{\star}%
        \ifnum#1>1\relax\ensuremath{\star}\fi
        \ifnum#1>2\relax\ensuremath{\star}\fi}%
    \fi
  \fi
}

\newcommand{\taskpic}[1]{%
  \par\medskip
  \begin{center}
    \includegraphics[width=0.78\linewidth,height=0.40\textheight,keepaspectratio]{#1}%
  \end{center}%
}

\newcommand{\egorbmr@maybeuncover}[2]{%
  \ifegorbmr@overlay
    \ifegorbmr@itemclick
      \edef\egorbmr@ov{\the\numexpr\egorbmr@lastitemov+#1-1\relax-}%
      \expandafter\only\expandafter<\egorbmr@ov>{#2}%
    \else
      \only<#1->{#2}%
    \fi
  \else
    #2%
  \fi
}

% Подпункты: items=all — все сразу; items=click — по оверлеям.
% itemflow=stack — накапливаются; itemflow=solo — по одному.
% Колонки при показе по клику отключаем: multicols ломает оверлеи.
% «only@» должно быть с catcode @=12, как в документе. В sty @ — буква,
% и Beamer не узнаёт действие only@ (пункты пропадают без оверлеев).
\begingroup
\catcode`\@=12
\gdef\egorbmrTEMPSTACK{\begin{enumerate}[<only@+->]}
\gdef\egorbmrTEMPSOLO{\begin{enumerate}[<only@+>]}
\endgroup
\let\egorbmr@enumstack\egorbmrTEMPSTACK
\let\egorbmr@enumsolo\egorbmrTEMPSOLO

\newenvironment{egoritems}[1][1]{%
  \normalsize\rmfamily
  \egorbmr@incolsfalse
  \ifegorbmr@itemclick
  \else
    \ifnum#1>1\relax\egorbmr@incolstrue\fi
  \fi
  \ifegorbmr@incols\begin{multicols}{#1}\fi
  \ifegorbmr@itemclick
    \ifegorbmr@itemsolo
      \setlength{\itemsep}{1.05em}%
      \setlength{\parsep}{0.35em}%
      \setbeamertemplate{enumerate item}{%
        \usebeamercolor[fg]{structure}\rmfamily\insertenumlabel}%
      \egorbmr@enumsolo
      \let\egorbmr@saveditem\item
      \def\item{\@ifnextchar[{\egorbmr@itemlbl}{\egorbmr@saveditem}}%
      \def\egorbmr@itemlbl[##1]{\egorbmr@saveditem[{##1}]}%
    \else
      \egorbmr@enumstack
    \fi
  \else
    \begin{enumerate}%
  \fi
}{%
  \end{enumerate}%
  \ifegorbmr@incols\end{multicols}\fi
  \ifegorbmr@itemclick
    \ifnum\value{beamerpauses}>1\relax
      \xdef\egorbmr@lastitemov{\the\numexpr\value{beamerpauses}-1\relax}%
      \xdef\egorbmr@afteritems{\the\value{beamerpauses}}%
    \fi
  \fi
}

% Заглушка: сетка рисует клетку в оставшемся месте кадра задачи.
\newcommand{\egorbmr@drawworkarea}{}
\NewDocumentCommand{\egorworkarea}{O{}}{}

\AtBeginEnvironment{frame}{\normalsize\rmfamily}
\BeforeBeginEnvironment{frame}{%
  \egorbmr@hadanswerfalse
  \gdef\egorbmr@lastitemov{1}%
  \gdef\egorbmr@afteritems{1}%
}

% Номер задачи на кадре — для label/ссылок (генератор всегда ставит).
\NewDocumentCommand{\egortask}{m}{%
  \gdef\egorbmr@no{#1}%
  \normalsize\rmfamily
}

\NewDocumentCommand{\egorjumpto}{mm}{%
  \hyperlink{#1}{\usebeamercolor[fg]{structure}#2}%
}

\long\def\egorbmr@defer@ii#1#2#3#4{%
  \g@addto@macro\egorbmr@appendix{\egorbmr@appframe{#2}{#1}{#3}{#4}}%
}
\NewDocumentCommand{\egorbmr@defer}{mm+m}{%
  \edef\egorbmr@tmpn{\egorbmr@no}%
  \expandafter\egorbmr@defer@ii\expandafter{\egorbmr@tmpn}{#1}{#2}{#3}%
}

% Решение — абзацы, не beamercolorbox: allowframebreaks не режет vbox.
\newcommand{\egorbmr@solutionbody}[1]{%
  \par\vspace{0.45em}%
  {\usebeamerfont{block title}\usebeamercolor[fg]{block title}%
    \textbf{Решение}\par}%
  \vspace{0.28em}%
  #1\par
}

% Кадры приложения не fragile: тело уже прошло через +m (как \egoranswer).
\long\def\egorbmr@appframe#1#2#3#4{%
  \begin{frame}[t,label=egor#1-#2]
    \frametitle{#2.\ #3}
    \begin{block}{#3}#4\end{block}
    \vspace{0.55em}%
    \egorjumpto{egortask-#2}{К задаче}
  \end{frame}%
}

\newcommand{\egorappendix}{%
  \ifegorbmr@endplace
    \ifx\egorbmr@appendix\@empty
    \else
      \ifegorbmr@showsolution
        \egorsection{Ответы и решения}%
      \else
        \egorsection{Ответы}%
      \fi
      \egorbmr@appendix
    \fi
  \fi
}

% Видимость ответа/решения задаёт пара content= / reveal=;
% генератор всегда кладёт блоки, если текст есть.
% reveal=end: на кадре задачи — ссылка, сами блоки уходят в \egorappendix.
\NewDocumentCommand{\egoranswer}{+m}{%
  \ifegorbmr@showanswer
    \ifegorbmr@endplace
      \egorbmr@defer{ans}{Ответ}{#1}%
      \par\vspace{0.45em}%
      {\small\egorjumpto{egorans-\egorbmr@no}{Ответ}}%
    \else
      \egorbmr@maybeuncover{2}{%
        \begin{block}{Ответ}#1\end{block}}%
    \fi
    \global\egorbmr@hadanswertrue
  \fi
}

\NewDocumentCommand{\egorsolution}{+m}{%
  \ifegorbmr@showsolution
    \ifegorbmr@endplace
      \egorbmr@defer{sol}{Решение}{#1}%
      \ifegorbmr@hadanswer
        {\small\quad\egorjumpto{egorsol-\egorbmr@no}{Решение}}%
      \else
        \par\vspace{0.45em}%
        {\small\egorjumpto{egorsol-\egorbmr@no}{Решение}}%
      \fi
    \else
      \ifegorbmr@hadanswer
        \egorbmr@maybeuncover{3}{\egorbmr@solutionbody{#1}}%
      \else
        \egorbmr@maybeuncover{2}{\egorbmr@solutionbody{#1}}%
      \fi
    \fi
  \fi
}

% Титул и рубрика: аргументы уходят в макросы, а frame остаётся
% «пустым» — так Beamer не ломается на кадрах внутри команды.
\newcommand{\egorbmr@paint@title}{%
  \vspace*{1.15cm}%
  \begin{center}
    {\usebeamercolor[fg]{title}\egorbmrchromefont\Huge\bfseries\egorbmr@t@title\par}%
    \ifx\egorbmr@t@sub\empty\else
      \vspace{0.55em}%
      {\usebeamercolor[fg]{subtitle}\Large\egorbmr@t@sub\par}%
    \fi
    \vspace{1.35cm}%
    {\large
      \makebox[0.40\paperwidth][l]{\egorbmr@t@grade}%
      \makebox[0.40\paperwidth][r]{\egorbmr@t@author}\par}%
  \end{center}
}

\newcommand{\egorbmr@paint@section}{%
  \vspace*{2.1cm}%
  \begin{center}
    {\usebeamercolor[fg]{egorsep}\egorbmrchromefont\Huge\bfseries\egorbmr@s@name\par}%
    \ifx\egorbmr@s@note\empty\else
      \vspace{0.7em}%
      {\usebeamercolor[fg]{egorsep}\large\egorbmr@s@note\par}%
    \fi
  \end{center}
}

\NewDocumentCommand{\egortitle}{mmmO{}}{%
  \gdef\egorbmr@t@title{#1}%
  \gdef\egorbmr@t@grade{#2}%
  \gdef\egorbmr@t@author{#3}%
  \gdef\egorbmr@t@sub{#4}%
  \title[{#1}]{#1}%
  \author{#3}%
  \date{#2}%
  \begin{frame}[plain]
    \egorbmr@paint@title
  \end{frame}%
}

\NewDocumentCommand{\egorsection}{mO{}}{%
  \section{#1}%
  \gdef\egorbmr@s@name{#1}%
  \gdef\egorbmr@s@note{#2}%
  \begingroup
    \setbeamercolor{background canvas}{bg=egor@navy}%
    \setbeamercolor{normal text}{fg=white,bg=egor@navy}%
    \setbeamercolor{egorsep}{fg=white,bg=egor@navy}%
    \begin{frame}[plain]
      \egorbmr@paint@section
    \end{frame}%
  \endgroup
}

% Хром (шапка, футер, блоки, титул) — всегда; клетка — только theme=grid.
\RequirePackage{egorbeamer-grid}

%% --- Знак делимости --------------------------------------------------------
% «a ⋮ b» как в задачниках: три точки высотой с цифру и отступы отношения.
% Стандартный \vdots поднимается выше строки и не даёт отступов. Тот же
% макрос \divby задан для KaTeX в static/js/math.js и formula.js.
\providecommand{\divby}{\mathrel{\vbox{\baselineskip.5ex\lineskiplimit\z@
  \kern-.15ex\hbox{.}\hbox{.}\hbox{.}}}}
