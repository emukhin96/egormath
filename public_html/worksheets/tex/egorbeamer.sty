% Кириллица: стандартный sans Beamer (lmsans) не содержит русских букв.
% Условия и подпункты — всегда CMU Serif (Computer Modern).
\usefonttheme{professionalfonts}
\usefonttheme{serif}
\def\egorbmr@val@school{school}
\def\egorbmr@val@inter{inter}
\IfFontExistsTF{CMU Serif}{%
  \setmainfont{CMU Serif}%
  \newfontfamily\egorbmrchromefont{CMU Serif}%
}{%
  \setmainfont{cmunrm.otf}[
    BoldFont=cmunbx.otf,
    ItalicFont=cmunti.otf,
    BoldItalicFont=cmunbi.otf]%
  \newfontfamily\egorbmrchromefont{cmunrm.otf}[
    BoldFont=cmunbx.otf,
    ItalicFont=cmunti.otf,
    BoldItalicFont=cmunbi.otf]%
}
\IfFontExistsTF{CMU Sans Serif}{%
  \setsansfont{CMU Sans Serif}%
  \newfontfamily\egorbmrnavfont{CMU Sans Serif}%
}{%
  \setsansfont{cmunss.otf}[
    BoldFont=cmunsx.otf,
    ItalicFont=cmunsi.otf,
    BoldItalicFont=cmunso.otf]%
  \newfontfamily\egorbmrnavfont{cmunss.otf}%
}
% Тело задач всегда Computer Modern (CMU). font= меняет только хром:
% заголовки кадров, титул, рубрики, колонтитул.
\ifx\egorbmr@font\egorbmr@val@school
  \IfFontExistsTF{SchoolBookC.ttf}{%
    \setfontfamily\egorbmrchromefont{SchoolBookC.ttf}[
      BoldFont=SchoolBookC-Bold.ttf,
      ItalicFont=SchoolBookC-Italic.ttf,
      BoldItalicFont=SchoolBookC-BoldItalic.ttf]%
  }{%
    \IfFontExistsTF{SchoolBookC}{\setfontfamily\egorbmrchromefont{SchoolBookC}}{}}%
\fi
\ifx\egorbmr@font\egorbmr@val@inter
  \IfFontExistsTF{Inter}{%
    \setfontfamily\egorbmrchromefont{Inter}[
      BoldFont={Inter Bold},
      ItalicFont={Inter Italic},
      BoldItalicFont={Inter Bold Italic}]%
    \setfontfamily\egorbmrnavfont{Inter}[
      BoldFont={Inter Bold},
      ItalicFont={Inter Italic},
      BoldItalicFont={Inter Bold Italic}]%
  }{%
    \IfFontExistsTF{Inter-Regular.otf}{%
      \setfontfamily\egorbmrchromefont{Inter-Regular.otf}[
        BoldFont=Inter-Bold.otf,
        ItalicFont=Inter-Italic.otf,
        BoldItalicFont=Inter-BoldItalic.otf]%
      \setfontfamily\egorbmrnavfont{Inter-Regular.otf}[
        BoldFont=Inter-Bold.otf,
        ItalicFont=Inter-Italic.otf,
        BoldItalicFont=Inter-BoldItalic.otf]%
    }{}}%
\fi

% Кегль после fontspec. Тело — \rmfamily (CM); хром — \egorbmrchromefont.
\newcommand{\egorbmr@usesize}[4]{%
  \renewcommand{\normalsize}{\fontsize{#1}{#2}\selectfont}%
  \normalsize
  \setbeamerfont{normal text}{family=\rmfamily,size=\normalsize}%
  \def\egorbmr@ftsize{#3}%
  \def\egorbmr@ftskip{#4}%
}
\ifnum\egorbmr@fontsize=11\relax
  \egorbmr@usesize{11pt}{13.6pt}{12.5}{15}%
  \renewcommand{\small}{\fontsize{10pt}{12pt}\selectfont}%
  \renewcommand{\footnotesize}{\fontsize{9pt}{11pt}\selectfont}%
  \renewcommand{\large}{\fontsize{12pt}{14.5pt}\selectfont}%
  \renewcommand{\Large}{\fontsize{14pt}{18pt}\selectfont}%
\else
  \ifnum\egorbmr@fontsize=14\relax
    \egorbmr@usesize{14pt}{18pt}{16}{20}%
    \renewcommand{\small}{\fontsize{12pt}{14.5pt}\selectfont}%
    \renewcommand{\footnotesize}{\fontsize{11pt}{13.6pt}\selectfont}%
    \renewcommand{\large}{\fontsize{17pt}{22pt}\selectfont}%
    \renewcommand{\Large}{\fontsize{20pt}{25pt}\selectfont}%
  \else
    \egorbmr@usesize{12pt}{14.5pt}{13}{16}%
    \renewcommand{\small}{\fontsize{11pt}{13.6pt}\selectfont}%
    \renewcommand{\footnotesize}{\fontsize{10pt}{12pt}\selectfont}%
    \renewcommand{\large}{\fontsize{14pt}{18pt}\selectfont}%
    \renewcommand{\Large}{\fontsize{17pt}{22pt}\selectfont}%
  \fi
\fi
