%% 8. КОМПАКТНАЯ МАТЕМАТИКА В КОЛОНКАХ
%%---------------------------------------------------------------------------
\newcommand{\columnedTightMathSetup}{%
  \setlength{\abovedisplayskip}{3pt}%
  \setlength{\belowdisplayskip}{0pt}%
  \setlength{\abovedisplayshortskip}{0pt}%
  \setlength{\belowdisplayshortskip}{0pt}%
  \setlength{\jot}{2pt}%
}
\newcommand{\columnedActivateTightMath}{%
  \let\colSavedNormalSize\normalsize
  \def\normalsize{\colSavedNormalSize\columnedTightMathSetup}%
  \let\colSavedSmall\small
  \def\small{\colSavedSmall\columnedTightMathSetup}%
  \let\colSavedFootnotesize\footnotesize
  \def\footnotesize{\colSavedFootnotesize\columnedTightMathSetup}%
  \let\colSavedScriptsize\scriptsize
  \def\scriptsize{\colSavedScriptsize\columnedTightMathSetup}%
  \let\colSavedTiny\tiny
  \def\tiny{\colSavedTiny\columnedTightMathSetup}%
  \let\colSavedLarge\large
  \def\large{\colSavedLarge\columnedTightMathSetup}%
  \let\colSavedLargeA\Large
  \def\Large{\colSavedLargeA\columnedTightMathSetup}%
  \let\colSavedLargeB\LARGE
  \def\LARGE{\colSavedLargeB\columnedTightMathSetup}%
  \let\colSavedHuge\huge
  \def\huge{\colSavedHuge\columnedTightMathSetup}%
  \let\colSavedHugeA\Huge
  \def\Huge{\colSavedHugeA\columnedTightMathSetup}%
  \normalsize
}
\newcommand{\columnedPostDisplay}{\par\nobreak}
\newcommand{\columnedSetupEverydisplay}{%
  \everydisplay\expandafter{\the\everydisplay \aftergroup\columnedPostDisplay}%
}

%%---------------------------------------------------------------------------
%% 9. \columned И КОМАНДЫ ЗАДАЧ
%%---------------------------------------------------------------------------
% При columns=0 четвёртый аргумент \task не печатается. Тем не менее
% \taskpic внутри него должен сработать: выполняем аргумент в выброшенном
% боксе, нейтрализуя \item (его опциональную метку всё же раскрываем —
% там тоже может стоять \taskpic).
\newsavebox{\egor@harvestbox}
\newcommand{\egor@harvestpics}[1]{%
  \ifblank{#1}{}{%
    \setbox\egor@harvestbox=\vbox{%
      \everypar{}%
      \renewcommand\item[1][]{##1}%
      #1%
    }%
  }%
}

\NewDocumentCommand{\columned}{m +m +m}{%
  % #1 = число колонок, #2 = текст перед списком, #3 = содержимое списка
  \begingroup
  \columnedActivateTightMath
  \columnedSetupEverydisplay
  \ifthenelse{\equal{#1}{0}}{%
    #2%
    \egor@harvestpics{#3}%
  }{%
    \ifthenelse{\equal{#1}{1}}{%
      #2%
      \begin{enumerate}[
        leftmargin=0pt,
        labelsep=0pt,
        labelindent=0pt,
        labelwidth=1.35em,
        itemindent=!,
        widest*={9},
        align=left,
        ] #3\end{enumerate}%
    }{%
      #2%
      \begin{multicols}{#1}%
        \begin{enumerate}[
        leftmargin=0pt,
        labelsep=0pt,
        labelindent=0pt,
        labelwidth=1.35em,
        itemindent=!,
        widest*={9},
        align=left
        ]
        \ignorespaces #3\end{enumerate}%
      \end{multicols}%
    }%
  }%
  \endgroup
}

% Задание: \task{звёздочки}{колонки}{условие}[подпункты][ответ][решение]
% В режиме homework (chem) обычные задачи скрываются, показываются \dtask.
\NewDocumentCommand{\task}{m m +m O{} O{} O{}}{%
  \ifbool{egor@dz}{}{%
    \item\stars{#1}%
         \columned{#2}{#3}{#4}%
         \ans{#5}\answer{#5}\resh{#6}%
  }%
}

% Задание только для домашней работы (аналог \dtask из chem.sty)
\NewDocumentCommand{\dtask}{m m +m O{} O{} O{}}{%
  \ifbool{egor@dz}{%
    \item\stars{#1}%
         \columned{#2}{#3}{#4}%
         \ans{#5}\answer{#5}\resh{#6}%
  }{}%
}

% Задание с обязательным (всегда видимым) ответом
\NewDocumentCommand{\taskans}{m m +m O{} O{} O{}}{%
  \item\stars{#1}%
       \columned{#2}{#3}{#4}%
  \par\cfbox{black}{#5}\answer{#5}\resh{#6}%
}

% Ответ сразу после задачи (виден в режиме answers=inline)
\NewDocumentCommand{\ans}{m}{%
  \ifbool{ans}{\ifblank{#1}{}{\par \cfbox{black}{#1}}}{}%
}

% Решение: в режиме solutions=inline печатается после задачи,
% в режиме solutions=table копится и печатается в конце документа.
\NewDocumentCommand{\resh}{m}{%
  \ifbool{resh}{\ifblank{#1}{}{\par \textit{Решение}. #1}}{}%
  \ifdefstring{\egor@solutionsmode}{table}{%
    \ifblank{#1}{}{%
      \edef\egor@solnum{\arabic{enumi}}%
      \expandafter\egor@recordsolution\expandafter{\egor@solnum}{#1}%
    }%
  }{}%
}

