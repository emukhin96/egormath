% ===== Автоуменьшение шрифта до попадания в \textwidth =====
\newsavebox{\autosizebox}
\newif\ifautosizedone
\newcommand{\AutosizeStep}[1]{%
  \ifautosizedone\relax
  \else
    \sbox{\autosizebox}{{#1 \autosize@text}}%
    \ifdim\wd\autosizebox>\textwidth
    \else
      {#1 \autosize@text\par}%
      \autosizedonetrue
    \fi
  \fi
}
\newcommand{\autosize}[1]{%
  \begingroup
    \def\autosize@text{#1}%
    \autosizedonefalse
    \AutosizeStep{\Large}%
    \AutosizeStep{\large}%
    \AutosizeStep{\normalsize}%
    \AutosizeStep{\small}%
    \AutosizeStep{\footnotesize}%
    \AutosizeStep{\scriptsize}%
    \AutosizeStep{\tiny}%
    \ifautosizedone\else {\tiny \autosize@text\par}\fi
  \endgroup
}

