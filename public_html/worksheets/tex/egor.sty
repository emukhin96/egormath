\newcommand*\egor@apply@school{%
  \RequirePackage[main=russian]{babel}%
  \RequirePackage{amsmath}%
  \RequirePackage{mathspec}%
  \setmainfont{SchoolBookC}[BoldFont={SchoolBookC Bold},ItalicFont={SchoolBookC Italic},BoldItalicFont={SchoolBookC Bold Italic}]%
  \setmathsfont(Digits,Latin){SchoolBookC}%
  \DeclareSymbolFont{punctuation}{\encodingdefault}{\familydefault}{m}{n}%
  \SetSymbolFont{punctuation}{bold}{\encodingdefault}{\familydefault}{b}{n}%
  \DeclareMathSymbol{,}{\mathpunct}{punctuation}{`,}%
  \DeclareMathSymbol{.}{\mathord}{punctuation}{`.}%
  \DeclareMathSymbol{;}{\mathpunct}{punctuation}{`;}%
  \setmathrm{SchoolBookC}\setboldmathrm{SchoolBookC Bold}%
  \setsansfont{TextBookC}\setmonofont{CMU Typewriter Text}%
  \RequirePackage{pifont}%
  \newfontfamily\cmserif{CMU Serif}%
  \let\oldsffamily\sffamily
  \renewcommand{\sffamily}{\oldsffamily\everymath{\sfmathsetup}}%
  \newcommand{\sfmathsetup}{\mathsf}%
}
\newcommand*\egor@apply@cm{%
  \RequirePackage[main=russian]{babel}%
  \RequirePackage{amsmath}%
  \RequirePackage{fontspec}%
  \defaultfontfeatures{Ligatures={TeX},Renderer=Basic}%
  \setmainfont{CMU Serif}%
  \setmainfont[Ligatures={TeX,Historic}]{CMU Serif}%
  \setsansfont{CMU Sans Serif}\setmonofont{CMU Typewriter Text}%
  \RequirePackage{pifont}%
  \newfontfamily\cmserif{CMU Serif}%
}
\newcommand*\egor@apply@palatino{%
  \RequirePackage[main=russian]{babel}%
  \RequirePackage{amsmath}%
  \RequirePackage{mathspec}%
  % macOS: системный Palatino (имена Palatino, Palatino Bold, …). latex-api (Linux): файлы
  % Palatino Linotype от Microsoft — fontconfig и XeTeX знают только полные имена.
  \IfFontExistsTF{Palatino Linotype}
    {\def\egor@pal{Palatino Linotype}\def\egor@palb{Palatino Linotype Bold}%
     \def\egor@pali{Palatino Linotype Italic}\def\egor@palbi{Palatino Linotype Bold Italic}}
    {\def\egor@pal{Palatino}\def\egor@palb{Palatino Bold}%
     \def\egor@pali{Palatino Italic}\def\egor@palbi{Palatino Bold Italic}}%
  \setmainfont{\egor@pal}[
    BoldFont={\egor@palb},
    ItalicFont={\egor@pali},
    BoldItalicFont={\egor@palbi}
  ]%
  \setmathsfont(Digits,Latin){\egor@pal}%
  \DeclareSymbolFont{punctuation}{\encodingdefault}{\familydefault}{m}{n}%
  \SetSymbolFont{punctuation}{bold}{\encodingdefault}{\familydefault}{b}{n}%
  \DeclareMathSymbol{,}{\mathpunct}{punctuation}{`,}%
  \DeclareMathSymbol{.}{\mathord}{punctuation}{`.}%
  \DeclareMathSymbol{;}{\mathpunct}{punctuation}{`;}%
  \setmathrm{\egor@pal}%
  \setboldmathrm{\egor@palb}%
  \setsansfont{TextBookC}\setmonofont{CMU Typewriter Text}%
  \RequirePackage{pifont}%
  \newfontfamily\cmserif{CMU Serif}%
  \let\oldsffamily\sffamily
  \renewcommand{\sffamily}{\oldsffamily\everymath{\sfmathsetup}}%
  \newcommand{\sfmathsetup}{\mathsf}%
}
\newcommand*\egor@apply@inter{%
  \RequirePackage[main=russian]{babel}%
  \RequirePackage{amsmath}%
  \RequirePackage{mathspec}%
  \IfFontExistsTF{Inter}{%
    \setmainfont{Inter}[BoldFont={Inter Bold},ItalicFont={Inter Italic},BoldItalicFont={Inter Bold Italic}]%
    \setmathsfont(Digits,Latin){Inter}%
    \setmathrm{Inter}\setboldmathrm{Inter Bold}%
    \setsansfont{Inter}%
  }{%
    \setmainfont{Inter-Regular.otf}[BoldFont=Inter-Bold.otf,ItalicFont=Inter-Italic.otf,BoldItalicFont=Inter-BoldItalic.otf]%
    \setmathsfont(Digits,Latin){Inter-Regular.otf}%
    \setmathrm{Inter-Regular.otf}\setboldmathrm{Inter-Bold.otf}%
    \setsansfont{Inter-Regular.otf}[BoldFont=Inter-Bold.otf,ItalicFont=Inter-Italic.otf,BoldItalicFont=Inter-BoldItalic.otf]%
  }%
  \DeclareSymbolFont{punctuation}{\encodingdefault}{\familydefault}{m}{n}%
  \SetSymbolFont{punctuation}{bold}{\encodingdefault}{\familydefault}{b}{n}%
  \DeclareMathSymbol{,}{\mathpunct}{punctuation}{`,}%
  \DeclareMathSymbol{.}{\mathord}{punctuation}{`.}%
  \DeclareMathSymbol{;}{\mathpunct}{punctuation}{`;}%
  \setmonofont{CMU Typewriter Text}%
  \RequirePackage{pifont}%
  \newfontfamily\cmserif{CMU Serif}%
  \let\oldsffamily\sffamily
  \renewcommand{\sffamily}{\oldsffamily\everymath{\sfmathsetup}}%
  \newcommand{\sfmathsetup}{\mathsf}%
}
% STIX Two Text + STIX Two Math через unicode-math (не mathspec): у STIX
% полноценный OpenType-математический шрифт, текст и формулы одного рисунка.
% Имена шрифтов — если STIX Two установлен в систему; иначе файлы OTF
% (TeX Live stix2-otf или файлы, приложенные к сборке рядом с .tex).
\newcommand*\egor@apply@stix{%
  \RequirePackage[main=russian]{babel}%
  \RequirePackage{amsmath}%
  \RequirePackage{fontspec}%
  \RequirePackage[math-style=TeX,bold-style=TeX]{unicode-math}%
  \IfFontExistsTF{STIX Two Text}{%
    \setmainfont{STIX Two Text}[Ligatures=TeX]%
  }{%
    \setmainfont{STIXTwoText}[
      Extension=.otf,
      UprightFont=*-Regular,
      ItalicFont=*-Italic,
      BoldFont=*-Bold,
      BoldItalicFont=*-BoldItalic,
      Ligatures=TeX]%
  }%
  \IfFontExistsTF{STIX Two Math}{%
    \setmathfont{STIX Two Math}%
  }{%
    \setmathfont{STIXTwoMath-Regular.otf}%
  }%
  % icomma читает \mathcode запятой в \begin{document}, а unicode-math
  % задаёт её через \Umathcode — сохраняем настоящий код заранее и
  % возвращаем после хуков icomma (begindocument/end идёт после них)
  \Umathcharnumdef\egor@mathcomma=\Umathcodenum`\,\relax
  \AddToHook{begindocument/end}{\let\mathcomma\egor@mathcomma}%
  \setsansfont{CMU Sans Serif}\setmonofont{CMU Typewriter Text}%
  \RequirePackage{pifont}%
  \newfontfamily\cmserif{CMU Serif}%
}
\newcommand*\egor@applyfonts{%
  \edef\egor@val{\egor@font}%
  \@ifundefined{egor@apply@\egor@val}{%
    \PackageError{egor}{Unknown value for font=\egor@font}{Allowed: cm, school, palatino, inter, stix.}%
  }{%
    \csname egor@apply@\egor@val\endcsname
  }%
}
\AtEndOfPackage{\egor@applyfonts}

