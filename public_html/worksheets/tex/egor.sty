\@ifpackageloaded{egormath}{%
  \PackageError{egor}{Package 'egormath' is already loaded.\MessageBreak
    egor replaces egormath; they cannot be used together}%
   {Remove \string\usepackage{egormath} from the preamble and keep only
    \string\usepackage{egor}.}}{}
\@ifpackageloaded{mathneo}{%
  \PackageError{egor}{Package 'mathneo' is already loaded.\MessageBreak
    egor replaces mathneo; they cannot be used together}%
   {Remove \string\usepackage{mathneo} from the preamble and keep only
    \string\usepackage{egor}.}}{}
\ifcsdef{numr}{%
  \PackageError{egor}{It looks like chem.sty is already loaded\MessageBreak
    (command \string\numr\space is defined). egor replaces chem.sty}%
   {Remove \string\usepackage{chem} from the preamble and use
    \string\usepackage[chem]{egor} instead.}}{}
\ifcsdef{task}{%
  \PackageError{egor}{Command \string\task\space is already defined by another
    package or by the document}%
   {egor defines its own \string\task. Remove the conflicting definition or
    load egor first.}}{}
% Перехват попытки загрузить легаси-пакет ПОСЛЕ egor: останавливаемся с
% понятным сообщением до того, как посыплются ошибки о переопределениях.
\AddToHook{package/egormath/before}{\PackageError{egor}%
  {Do not load 'egormath' together with 'egor'}%
  {Remove \string\usepackage{egormath}: package egor already provides
   everything from egormath.}}
\AddToHook{package/mathneo/before}{\PackageError{egor}%
  {Do not load 'mathneo' together with 'egor'}%
  {Remove \string\usepackage{mathneo}: package egor already provides
   everything from mathneo (use option 'diagn' for the diagnostic mode).}}
\AddToHook{package/chem/before}{\PackageError{egor}%
  {Do not load 'chem' together with 'egor'}%
  {Remove \string\usepackage{chem} and use \string\usepackage[chem]{egor}
   instead.}}

