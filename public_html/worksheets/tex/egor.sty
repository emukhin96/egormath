%%---------------------------------------------------------------------------
%% 19. ГРАФИКИ TIKZ (из tikz-apo.tex, доработано)
%%---------------------------------------------------------------------------
% Координатная плоскость по координатам углов:
%   \xoy[опции tikz][xvar][yvar]{x1}{y1}{x2}{y2}{код}
% Подписи осей по умолчанию x и y; размер шрифта подписей наследуется от
% текущего кегля документа (масштаб tikz на текст не влияет).
\NewDocumentCommand{\xoy}{O{} O{x} O{y} m m m m +m}{%
\begin{tikzpicture}[#1]
    % Фон и клетка (клетка на 1 внутрь, фон на 1 наружу)
    \fill[white, opacity=1] (#4-1,#5-1) rectangle (#6+1,#7+1);
    \draw[very thin, gray, step=1] (#4+1,#5+1) grid (#6-1,#7-1);
    % Оси
    \draw[thick,->, line width=0.5mm] (#4,0) -- (#6,0) node[below, yshift=-2pt] {$#2$};
    \draw[thick,->, line width=0.5mm] (0,#5) -- (0,#7) node[anchor=west, xshift=3pt, yshift=-3pt] {$#3$};
    % Единичные отрезки
    \draw[black, thick] (1,-0.1) -- (1,0.1) node[below, yshift=-2pt, font=\small] {1};
    \draw[black, thick] (-0.1,1) -- (0.1,1) node[left, xshift=-2pt, font=\small] {1};
    #8
\end{tikzpicture}%
}

% Кусок графика одной строкой (внутри \xoy или tikzpicture):
% \graphplot[доп. опции]{domain}{формула от \x}
\NewDocumentCommand{\graphplot}{O{} m m}{%
  \draw[black, line width=0.8mm, samples=120, domain=#2, #1] plot (\x, {#3});%
}

% Координатная прямая: \numline[опции tikz][var]{от}{до}{точки}
% Штрихи и подписи целых чисел расставляются автоматически.
% Точки: список через запятую; «2» — закрашенная, «2/o» — выколотая.
% Второй необязательный аргумент — переменная оси (по умолчанию x).
\NewDocumentCommand{\numline}{O{} O{x} m m +m}{%
\begin{tikzpicture}[#1]
    \draw[thick,->, line width=0.5mm] (#3-0.6,0) -- (#4+1,0)
        node[below, font=\small, yshift=-5pt] {$#2$};
    \foreach \n in {#3,...,#4}{%
        \draw[black, thick] (\n,-0.1) -- (\n,0.1)
            node[below, yshift=-7pt, font=\small] {$\n$};
    }%
    \ifblank{#5}{}{%
      \foreach \p/\t in {#5}{%
        \ifdefstring{\t}{o}%
          {\filldraw[fill=white, draw=black, thick] (\p,0) circle (3pt);}%
          {\filldraw[black] (\p,0) circle (3pt);}%
      }%
    }%
\end{tikzpicture}%
}

%%---------------------------------------------------------------------------
%% 20. КАРТИНКИ ВНИЗУ СТРАНИЦЫ: \taskpic + \flushpics
%%---------------------------------------------------------------------------
% \taskpic{file}  — внутри условия или подпунктов: запоминает картинку,
%                   подпись «К задаче N» берётся из номера текущей задачи.
%                   Работает и в четвёртом аргументе \task при columns=0
%                   (аргумент не печатается, картинка всё равно копится).
% \taskpic[7]{file} — номер задачи можно задать вручную.
% \flushpics      — выпускает накопленные картинки одним блоком внизу
%                   страницы (float [b]); ширина каждой считается сама.
% \flushpics[2]   — не больше 2 картинок в ряду (то же глобально: \picsperrow{2}).
\newcommand{\taskpicname}{К задаче}
\newcommand{\egor@piclist}{}
\newcommand{\egor@maxpicsperrow}{0}
\newcommand{\picsperrow}[1]{\gdef\egor@maxpicsperrow{#1}}
\newlength{\egor@picsep}
\setlength{\egor@picsep}{5mm}
\newlength{\egor@picwidth}
\newcounter{egorpictotal}
\newcounter{egorpiccnt}
\newcounter{egorpicinrow}
\newcommand{\egor@k}{1}

\NewDocumentCommand{\taskpic}{o m}{%
  \IfNoValueTF{#1}%
    {% Внутри подпункта (2-й уровень enumerate) к номеру задачи
     % добавляется буква подпункта: «К задаче 2б».
     \ifnum\@enumdepth>1
       \edef\egor@ansnum{\arabic{enumi}\egor@subnumeral{\value{enumii}}}%
     \else
       \edef\egor@ansnum{\arabic{enumi}}%
     \fi}%
    {\edef\egor@ansnum{#1}}%
  \expandafter\egor@addpic\expandafter{\egor@ansnum}{#2}%
}
\newcommand{\egor@addpic}[2]{%
  \listgadd{\egor@piclist}{{#1}{#2}}%
}
\newcommand{\egor@countpic}[1]{\stepcounter{egorpictotal}}
% Картинка не растягивается больше натуральной ширины.
\newsavebox{\egor@picbox}
\newcommand{\egor@fitpic}[1]{%
  \sbox{\egor@picbox}{\includegraphics{#1}}%
  \ifdim\wd\egor@picbox>\linewidth
    \includegraphics[width=\linewidth]{#1}%
  \else
    \usebox{\egor@picbox}%
  \fi
}
\newcommand{\egor@emitpic}[1]{\egor@emitpicaux#1}
\newcommand{\egor@emitpicaux}[2]{%
  \stepcounter{egorpiccnt}%
  \stepcounter{egorpicinrow}%
  \begin{minipage}[t]{\egor@picwidth}%
    \centering
    {\itshape\small \taskpicname~#1}\\[1.8mm]
    \egor@fitpic{#2}%
  \end{minipage}%
  \ifnum\value{egorpicinrow}<\egor@k\relax
    \ifnum\value{egorpiccnt}<\value{egorpictotal}\hspace{\egor@picsep}\fi
  \else
    \setcounter{egorpicinrow}{0}%
    \ifnum\value{egorpiccnt}<\value{egorpictotal}\\[3mm]\fi
  \fi\ignorespaces
}

\NewDocumentCommand{\flushpics}{O{0}}{%
  \ifdefempty{\egor@piclist}{}{%
    \setcounter{egorpictotal}{0}%
    \forlistloop{\egor@countpic}{\egor@piclist}%
    \ifnum#1>0
      \edef\egor@k{#1}%
    \else
      \ifnum\egor@maxpicsperrow>0
        \ifnum\value{egorpictotal}>\egor@maxpicsperrow
          \edef\egor@k{\egor@maxpicsperrow}%
        \else
          \edef\egor@k{\arabic{egorpictotal}}%
        \fi
      \else
        \edef\egor@k{\arabic{egorpictotal}}%
      \fi
    \fi
    % [!b] — игнорируем лимит \bottomfraction, иначе блок из нескольких
    % картинок легко уезжает на отдельную страницу-вкладку.
    \begin{figure}[!b]
      \centering
      % Небольшой запас (1pt на картинку), чтобы ряд из k картинок,
      % заполняющий строку впритык, не разваливался из-за округления.
      \setlength{\egor@picwidth}{\dimexpr(\linewidth - \egor@picsep*\numexpr\egor@k-1\relax)/\egor@k - 1pt\relax}%
      \setcounter{egorpiccnt}{0}\setcounter{egorpicinrow}{0}%
      \forlistloop{\egor@emitpic}{\egor@piclist}%
    \end{figure}%
    \gdef\egor@piclist{}%
  }%
}

% Забытые картинки выпускаем сами в конце документа
\AtEndDocument{%
  \ifdefempty{\egor@piclist}{}{%
    \PackageWarningNoLine{egor}{There were task pictures left unflushed.
      I emitted them at the end; add \string\flushpics\space where you want
      them placed}%
    \flushpics
  }%
}

