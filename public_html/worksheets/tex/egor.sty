\newcommand{\annot}[1]{%
    \begin{tikzpicture}[overlay,remember picture]
        \node[anchor=west, yshift=0.25\baselineskip, text width=\linewidth] (itemtext) {};
        \node[left=\the\labelwidth of itemtext.west, anchor=east, font=\scshape, align=right, text width=1cm] {\commentbox{#1}};
    \end{tikzpicture}%
    }
\newcommand{\annotnoframe}[1]{%
