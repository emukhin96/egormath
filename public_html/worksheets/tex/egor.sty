%%---------------------------------------------------------------------------
%% 13. СПИСКИ ЗАДАЧ: АВТОСТАРТ ЧЕРЕЗ \rubr
%%---------------------------------------------------------------------------
% Явный флаг «открыт ли список задач 1-го уровня» — надёжнее, чем проверка
% счётчика enumi. Флаг обновляется на любом enumerate 1-го уровня,
% в том числе открытом или закрытом вручную.
\newbool{egor@listopen}
\AtBeginEnvironment{enumerate}{\ifnum\@enumdepth=0 \global\booltrue{egor@listopen}\fi}
\AtEndEnvironment{enumerate}{\ifnum\@enumdepth=1 \global\boolfalse{egor@listopen}\fi}

%%%%% Команда для «рубрик» %%%%%
% \rubr{Название}[текст-правило]. Если список задач ещё не открыт, открывает
% его; если открыт — продолжает нумерацию. В режиме homework (chem) рубрика
% не печатается, но списком управляет по-прежнему.
\NewDocumentCommand{\rubr}{m O{}}{%
  \ifbool{egor@dz}{}{%
    \stepcounter{numrubr}%
    \vspace{0.4em}%
  }%
  \egor@closelist
  \ifbool{egor@dz}{}{%
    \begin{rubrbox} \circled{\sf \small \arabic{numrubr}} \; \sf #1 \end{rubrbox}\vspace{-0.4em}%
  }%
  \ifnum\value{enumi}=0
    \begin{enumerate}[before=\ruletextrubr{#2}]
  \else
    \begin{enumerate}[resume,before=\ruletextrubr{#2}]
  \fi
}

% Совместимость: рубрика с продолжением нумерации (требует открытого списка)
\newcommand{\rubro}[1]{\egor@closelist\rubr{#1}}

% Дружелюбная проверка в конце документа: незакрытый список закрываем сами,
% но предупреждаем автора.
\AtEndDocument{%
  \ifbool{egor@listopen}{%
    \PackageWarningNoLine{egor}{The task list was still open at \string\end{document}.
      I closed it for you, but please add \string\end{enumerate} at the end of
      the document}%
    \end{enumerate}%
  }{}%
}

