\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{egor}[2026/10/01 v1.3.1 school math and chemistry task sheets]

%%==========================================================================
%% egor.sty — пакет для оформления списков задач по математике и химии.
%% Преемник egormath.sty (совместим с ним по командам), вобравший функционал
%% mathneo.sty (режим diagn) и chem.sty (опция chem, режимы домашки).
%% Компилятор: xelatex.
%%==========================================================================

\RequirePackage{etoolbox}

%%---------------------------------------------------------------------------
%% 1. ОПЦИИ ПАКЕТА
%%---------------------------------------------------------------------------
%% font=cm|school|palatino|inter|stix — шрифтовой профиль
%% labelstyle=cyrillic|latin — метки списков 2-го уровня
%% answers=none|inline|table — режим показа ответов (унифицированный)
%% solutions / solutions=true|false — показывать решения
%% diagn — режим диагностической работы (номера задач в рамках)
%% chem  — химический инструментарий (mhchem, chemfig, \numr, \dtask, ...)
%% Легаси-алиасы: ans, ans=true|false, resh, resh=true|false, reshans, tasks,
%%                class-student, class-teacher, homework-student, homework-teacher

\newcommand{\egor@font}{cm}
\newcommand{\egor@labelstyle}{cyrillic}
\newcommand{\egor@answersmode}{none}
% solutions=none|inline|table; булев egor@solutions означает «инлайн-печать»
\newcommand{\egor@solutionsmode}{none}
\newbool{egor@solutions}
\newcommand{\egor@setsolutions}[1]{%
  \renewcommand{\egor@solutionsmode}{#1}%
  \ifstrequal{#1}{inline}{\booltrue{egor@solutions}}{\boolfalse{egor@solutions}}%
}
\newbool{egor@diagn}
\newbool{egor@chem}
\newbool{egor@dz}
% annot=true (по умолчанию) — слева зарезервировано место под аннотации
% (\oge, \fipi, звёздочки); annot=false — резерв убирается, номер задачи
% начинается вровень с левой границей рамки \bighead.
\newbool{egor@annot}
\booltrue{egor@annot}

\DeclareOption{font=cm}{\renewcommand{\egor@font}{cm}}
\DeclareOption{font=school}{\renewcommand{\egor@font}{school}}
\DeclareOption{font=palatino}{\renewcommand{\egor@font}{palatino}}
\DeclareOption{font=inter}{\renewcommand{\egor@font}{inter}}
\DeclareOption{font=stix}{\renewcommand{\egor@font}{stix}}
\DeclareOption{labelstyle=cyrillic}{\renewcommand{\egor@labelstyle}{cyrillic}}
\DeclareOption{labelstyle=latin}{\renewcommand{\egor@labelstyle}{latin}}

\DeclareOption{answers=none}{\renewcommand{\egor@answersmode}{none}}
\DeclareOption{answers=inline}{\renewcommand{\egor@answersmode}{inline}}
\DeclareOption{answers=table}{\renewcommand{\egor@answersmode}{table}}
\DeclareOption{solutions}{\egor@setsolutions{inline}}
\DeclareOption{solutions=true}{\egor@setsolutions{inline}}
\DeclareOption{solutions=false}{\egor@setsolutions{none}}
\DeclareOption{solutions=none}{\egor@setsolutions{none}}
\DeclareOption{solutions=inline}{\egor@setsolutions{inline}}
\DeclareOption{solutions=table}{\egor@setsolutions{table}}

\DeclareOption{diagn}{\booltrue{egor@diagn}}
\DeclareOption{chem}{\booltrue{egor@chem}}
\DeclareOption{annot=true}{\booltrue{egor@annot}}
\DeclareOption{annot=false}{\boolfalse{egor@annot}}

% --- Легаси-алиасы (egormath/mathneo). Работают, но подсказывают новый синтаксис.
\newcommand{\egor@legacyinfo}[2]{%
  \PackageInfo{egor}{Option '#1' is a legacy alias; prefer '#2'}}
\DeclareOption{ans}{\renewcommand{\egor@answersmode}{inline}\egor@legacyinfo{ans}{answers=inline}}
\DeclareOption{ans=true}{\renewcommand{\egor@answersmode}{inline}\egor@legacyinfo{ans=true}{answers=inline}}
\DeclareOption{ans=false}{\renewcommand{\egor@answersmode}{none}}
\DeclareOption{resh}{\egor@setsolutions{inline}\egor@legacyinfo{resh}{solutions=inline}}
\DeclareOption{resh=true}{\egor@setsolutions{inline}\egor@legacyinfo{resh=true}{solutions=inline}}
\DeclareOption{resh=false}{\egor@setsolutions{none}}
\DeclareOption{reshans}{\renewcommand{\egor@answersmode}{inline}\egor@setsolutions{inline}%
  \egor@legacyinfo{reshans}{answers=inline, solutions=inline}}
\DeclareOption{tasks}{\renewcommand{\egor@answersmode}{none}\egor@setsolutions{none}}

% --- Легаси-алиасы (chem): классная/домашняя работа, ученик/учитель
\DeclareOption{class-student}{\boolfalse{egor@dz}\egor@setsolutions{none}}
\DeclareOption{class-teacher}{\boolfalse{egor@dz}\egor@setsolutions{inline}}
\DeclareOption{homework-student}{\booltrue{egor@dz}\egor@setsolutions{none}}
\DeclareOption{homework-teacher}{\booltrue{egor@dz}\egor@setsolutions{inline}}
\DeclareOption{homework}{\booltrue{egor@dz}}

\DeclareOption*{%
  \PackageError{egor}{Unknown option '\CurrentOption'}%
   {Valid options: font=cm|school|palatino|inter|stix, labelstyle=cyrillic|latin,\MessageBreak
    answers=none|inline|table, solutions=none|inline|table,\MessageBreak
    annot=true|false, diagn, chem, homework,\MessageBreak
    legacy: ans, resh, reshans, tasks, class-student, class-teacher,\MessageBreak
    homework-student, homework-teacher.}}
\ProcessOptions\relax

