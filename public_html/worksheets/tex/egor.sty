\newcommand{\showbaselines}{%
\AddToShipoutPicture{%
  \begin{tikzpicture}[overlay,remember picture]
      \foreach \i in {0,...,\the\numexpr\paperheight/\baselineskip\relax} {
          \draw [blue, ultra thin] ([yshift=-\i*\baselineskip]current page.north west) -- ([yshift=-\i*\baselineskip]current page.north east);
      }
  \end{tikzpicture}%
}%
}

