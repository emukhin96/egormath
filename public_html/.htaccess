Options +ExecCGI
AddHandler wsgi-script .py
AddDefaultCharset UTF-8

# --- Кэширование статики ---
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|svg|ico|webp|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# --- Сжатие текстовых ответов ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

RewriteEngine On

# 1) Статика: /static/... -> staticfiles/... (результат collectstatic)
RewriteCond %{REQUEST_URI} ^/static/(.*)$
RewriteCond %{DOCUMENT_ROOT}/staticfiles/%1 -f
RewriteRule ^static/(.*)$ /staticfiles/$1 [L]

# 2) Существующие файлы отдаём напрямую
#    (медиа-файлы лежат ВНЕ public_html и раздаются только через Django)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 2a) Файлы-версии живых страниц (live/<токен>.txt, см. livefile/files.py):
#     существующие отдал пункт 2; отсутствующий — 404 сразу, без запуска
#     Django. Заголовки для них — в live/.htaccess.
RewriteRule ^live/ - [R=404,L]

# 3) Предотвращаем зацикливание
RewriteCond %{REQUEST_URI} !^/wsgi.py(?:/|$)

# 4) Всё остальное — в Django
RewriteRule ^(.*)$ /wsgi.py/$1 [QSA,PT,L]
